    {
      "id": "agents_graphify_query_first",
      "label": "Graphify query-first investigation workflow",
      "file_type": "rationale",
      "source_file": "/Volumes/[C] Windows Trade Station/Users/mark/development/DASTraderScripts/AGENTS.md",
      "source_location": "19-44",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Existing graph queries scope source inspection; missing or unavailable graph access has fallback paths so authorized work can continue."
    },
    {
      "id": "agents_graphify_vocabulary_and_paths",
      "label": "Graph vocabulary and path direction rules",
      "file_type": "rationale",
      "source_file": "/Volumes/[C] Windows Trade Station/Users/mark/development/DASTraderScripts/AGENTS.md",
      "source_location": "24-29",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Expand unfamiliar wording against actual graph labels and use undirected paths intentionally; a missing directed path does not disprove a relationship."
    },
    {
      "id": "agents_graphify_source_verification",
      "label": "Current-source verification of graph claims",
      "file_type": "rationale",
      "source_file": "/Volumes/[C] Windows Trade Station/Users/mark/development/DASTraderScripts/AGENTS.md",
      "source_location": "48-55",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Verify changed source and current line locations because a matching commit or stale graph claim does not establish current evidence."
    },
    {
      "id": "agents_graphify_pending_refresh",
      "label": "Pending-refresh accounting requirement",
      "file_type": "rationale",
      "source_file": "/Volumes/[C] Windows Trade Station/Users/mark/development/DASTraderScripts/AGENTS.md",
      "source_location": "48-52",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Check pending-refresh.json and clear entries only after actual re-extraction and merging."
    },
    {
      "id": "agents_graphify_evidence_limits",
      "label": "Graph and regression evidence limitations",
      "file_type": "rationale",
      "source_file": "/Volumes/[C] Windows Trade Station/Users/mark/development/DASTraderScripts/AGENTS.md",
      "source_location": "56-60",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Preserve extraction confidence distinctions; undirected paths do not prove runtime reachability and regression results do not prove installed DAS behavior or fills."
    },
    {
      "id": "agents_graphify_das_aware_refresh",
      "label": "DAS-aware extraction and merge requirement",
      "file_type": "rationale",
      "source_file": "/Volumes/[C] Windows Trade Station/Users/mark/development/DASTraderScripts/AGENTS.md",
      "source_location": "64-74",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The standard parser does not recognize DAS files; refreshes require DAS adapter output, fresh test extraction, current semantic results, and preservation of unrelated evidence."
    },
    {
      "id": "agents_graphify_retained_evidence_builder",
      "label": "Retained-evidence builder limitation",
      "file_type": "rationale",
      "source_file": "/Volumes/[C] Windows Trade Station/Users/mark/development/DASTraderScripts/AGENTS.md",
      "source_location": "75-79",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The project builder renders retained extraction evidence and does not extract or merge new DAS output automatically."
    },
    {
      "id": "agents_graphify_refresh_integrity",
      "label": "Refresh integrity and provenance requirements",
      "file_type": "rationale",
      "source_file": "/Volumes/[C] Windows Trade Station/Users/mark/development/DASTraderScripts/AGENTS.md",
      "source_location": "80-87",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Preserve source locations and parallel-edge evidence, update manifest/cache only for processed files, and disclose stale scope and unavailable token usage."
    },
    {
      "id": "agents_graphify_operational_boundary",
      "label": "Graph maintenance operational boundary",
      "file_type": "rationale",
      "source_file": "/Volumes/[C] Windows Trade Station/Users/mark/development/DASTraderScripts/AGENTS.md",
      "source_location": "88-89",
      "source_url": null,
      "captured_at": null,
      "author": null,
